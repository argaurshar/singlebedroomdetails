{
  "name": "room-anatomy",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-cabinet.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist",
    "test:browser": "python3 tests/browser.py",
    "test:study": "python3 tests/study-browser.py",
    "test:cabinet": "python3 tests/cabinet-browser.py",
    "audit:cabinet": "node scripts/audit-cabinet.mjs"
  }
}
