{
  "name": "room-anatomy",
  "version": "3.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-cabinet.mjs && node scripts/build-library.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "python3 -m http.server 4173 --bind 0.0.0.0 --directory dist",
    "test:browser": "python3 tests/browser.py",
    "test:study": "python3 tests/study-browser.py",
    "test:cabinet": "python3 tests/cabinet-browser.py",
    "audit:cabinet": "node scripts/audit-cabinet.mjs",
    "test:library": "python3 tests/library-browser.py",
    "audit:library": "node scripts/audit-library.mjs",
    "postinstall": "node scripts/prepare-anatomy-runtime.mjs",
    "prebuild": "node scripts/prepare-anatomy-runtime.mjs",
    "pretest": "node scripts/prepare-anatomy-runtime.mjs",
    "preaudit:library": "node scripts/prepare-anatomy-runtime.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
